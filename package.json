{
  "name": "@aclif/core",
  "version": "1.3.1",
  "description": "Agent CLI Framework: command-line tools for AI agents, one grammar and canonical names across every SaaS provider",
  "type": "module",
  "license": "MIT",
  "author": "Prompt One, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-cli-framework/aclif.git"
  },
  "homepage": "https://github.com/agent-cli-framework/aclif#readme",
  "bugs": {
    "url": "https://github.com/agent-cli-framework/aclif/issues"
  },
  "keywords": [
    "cli",
    "agent",
    "ai",
    "oclif",
    "salesforce",
    "servicenow",
    "docusign",
    "agentforce",
    "framework"
  ],
  "bin": {
    "aclif": "bin/run.js",
    "aclif-scaffold-cli": "scripts/scaffold-cli.mjs"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./providers": {
      "types": "./lib/providers/index.d.ts",
      "default": "./lib/providers/index.js"
    },
    "./testing": {
      "types": "./lib/testing/index.d.ts",
      "default": "./lib/testing/index.js"
    },
    "./hooks/init": {
      "types": "./lib/cli/hooks/init.d.ts",
      "default": "./lib/cli/hooks/init.js"
    },
    "./hooks/prerun": {
      "types": "./lib/cli/hooks/prerun.d.ts",
      "default": "./lib/cli/hooks/prerun.js"
    },
    "./hooks/finally": {
      "types": "./lib/cli/hooks/finally.d.ts",
      "default": "./lib/cli/hooks/finally.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/bin",
    "/lib",
    "/schemas",
    "/skills",
    "/scripts/gen-provider-index.mjs",
    "/scripts/scaffold-cli.mjs",
    "/oclif.manifest.json"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-data.mjs && node scripts/gen-topics.mjs",
    "check-sync-boundary": "node scripts/check-sync-boundary.mjs",
    "dev": "ts-node ./bin/run.ts",
    "golden:capture": "tsx scripts/capture-golden.ts",
    "golden:check": "tsx scripts/capture-golden.ts --check",
    "lint": "eslint .",
    "manifest": "oclif manifest",
    "postinstall": "node scripts/gen-provider-index.mjs",
    "postpack": "rm -f oclif.manifest.json",
    "posttest": "npm run lint && npm run test:circular",
    "prebuild": "node scripts/gen-provider-index.mjs",
    "prepack": "rm -rf lib && npm run build && oclif manifest",
    "scaffold-provider": "node scripts/scaffold-provider.mjs",
    "test": "vitest run",
    "test:circular": "madge --circular lib/",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test:coverage": "vitest run --coverage",
    "posttest:coverage": "npm run lint && npm run test:circular",
    "prepare": "husky || true",
    "release:version": "node scripts/release-version.mjs",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "dependencies": {
    "@googleapis/calendar": "^16.0.0",
    "@googleapis/gmail": "^22.0.0",
    "@oclif/core": "^5.0.0",
    "google-auth-library": "^10.0.0",
    "js-yaml": "^5.4.1",
    "jsforce": "^3.6.2",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.5.2",
    "marked": "^14.1.4"
  },
  "peerDependencies": {
    "ajv": "^8.12.0",
    "msw": "^2.0.0",
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    },
    "msw": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@oclif/test": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "ajv": "^8.20.0",
    "eslint": "^10.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "madge": "^8.0.0",
    "msw": "^2.15.0",
    "oclif": "^6.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "oclif": {
    "bin": "aclif",
    "dirname": "aclif",
    "commands": {
      "strategy": "explicit",
      "target": "./lib/commands-index.js",
      "identifier": "COMMANDS"
    },
    "topicSeparator": " ",
    "jitPlugins": {},
    "topics": {
      "agentforce": {
        "description": "Salesforce Agentforce agent sessions"
      },
      "agentforce:agents": {
        "description": "Inspect agents configured in the connected Salesforce org"
      },
      "agentforce:sessions": {
        "description": "Start, message, and end conversation sessions with an Agentforce agent"
      },
      "aliases": {
        "description": "Canonical entity and field names across providers"
      },
      "auth": {
        "description": "Identity, profile, and cached sessions"
      },
      "discover": {
        "description": "List all available providers, topics, and commands"
      },
      "docusign": {
        "description": "DocuSign eSignature envelopes"
      },
      "docusign:envelopes": {
        "description": "Create, list, inspect, and download signature envelopes"
      },
      "google": {
        "description": "Google Workspace: Gmail, Calendar, Drive"
      },
      "google:calendar": {
        "description": "List, create, update, and delete Google Calendar events"
      },
      "google:drive": {
        "description": "Links to Google Drive files"
      },
      "google:gmail": {
        "description": "Search, read, and send Gmail messages"
      },
      "learn": {
        "description": "Compact agent briefing for a provider"
      },
      "manifests": {
        "description": "Validate and list declarative command manifests"
      },
      "salesforce": {
        "description": "Salesforce CRM and Platform operations"
      },
      "salesforce:apex": {
        "description": "Execute and manage Apex code and triggers"
      },
      "salesforce:data": {
        "description": "Query and manage Salesforce records"
      },
      "salesforce:debug-log": {
        "description": "Manage debug logging"
      },
      "salesforce:files": {
        "description": "Links to files and attachments in the Salesforce UI"
      },
      "salesforce:metadata": {
        "description": "Manage custom objects, fields, and permissions"
      },
      "servicenow": {
        "description": "ServiceNow ITSM and Platform operations"
      },
      "servicenow:data": {
        "description": "Query and manage ServiceNow records"
      },
      "servicenow:script": {
        "description": "Execute ServiceNow background scripts"
      }
    },
    "exitCodes": {
      "default": 1,
      "invalidArgsSpec": 2,
      "requiredArgs": 2,
      "unexpectedArgs": 2,
      "failedFlagValidation": 2,
      "failedFlagParsing": 2,
      "nonExistentFlag": 2
    },
    "hooks": {
      "init": "./lib/cli/hooks/init",
      "prerun": "./lib/cli/hooks/prerun",
      "finally": "./lib/cli/hooks/finally"
    }
  }
}
