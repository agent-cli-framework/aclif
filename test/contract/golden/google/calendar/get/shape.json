{
  "command": "google:calendar:get",
  "responseShape": {
    "description": "Full calendar event details",
    "fields": {
      "id": {
        "type": "string",
        "description": "Event ID"
      },
      "summary": {
        "type": "string",
        "description": "Event title"
      },
      "description": {
        "type": "string",
        "nullable": true,
        "description": "Event description"
      },
      "start": {
        "type": "string",
        "description": "Start time (RFC3339)"
      },
      "end": {
        "type": "string",
        "description": "End time (RFC3339)"
      },
      "status": {
        "type": "string",
        "description": "Event status (confirmed, tentative, cancelled)"
      },
      "attendees": {
        "type": "array",
        "description": "List of attendees"
      }
    },
    "example": {
      "id": "evt123",
      "summary": "Meeting",
      "start": "2026-04-10T10:00:00Z",
      "end": "2026-04-10T11:00:00Z",
      "status": "confirmed"
    }
  }
}
