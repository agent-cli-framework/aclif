{
  "command": "docusign:envelopes:delete",
  "responseShape": {
    "description": "Move result",
    "fields": {
      "envelopeId": {
        "type": "string",
        "description": "Envelope GUID that was moved"
      },
      "folderId": {
        "type": "string",
        "description": "Destination folder (default recyclebin)"
      },
      "deleted": {
        "type": "boolean",
        "description": "true when the destination was recyclebin"
      }
    },
    "example": {
      "envelopeId": "abc-123",
      "folderId": "recyclebin",
      "deleted": true
    }
  }
}
