      "required": false
    },
    "dry-run": {
      "type": "boolean",
      "description": "Preview the operation without executing",
      "required": false,
      "default": false
    },
    "estimate": {
      "type": "boolean",
      "description": "Estimate response size without executing",
      "required": false,
      "default": false
    },
    "diff": {
      "type": "boolean",
      "description": "Show only changed fields (for mutations)",
      "required": false,
      "default": false
    },
    "truncate": {
      "type": "option",
      "description": "Max records to return",
      "required": false
    },
    "full": {
      "type": "boolean",
      "description": "Include sensitive values in output (passwords, tokens)",
      "required": false,
      "default": false
    },
    "pretty": {
      "type": "boolean",
      "description": "Colored output for human reading",
      "required": false,
      "default": false
    },
    "schema": {
      "type": "boolean",
      "description": "Output command schema as JSON",
      "required": false,
      "default": false
    },
    "changelog": {
      "type": "boolean",
      "description": "Output command version history",
      "required": false,
      "default": false
    },
    "discover": {
      "type": "boolean",
      "description": "List available sub-topics and commands",
      "required": false,
      "default": false
    },
    "examples": {
      "type": "boolean",
      "description": "Show usage examples with response shapes",
      "required": false,
      "default": false
    },
