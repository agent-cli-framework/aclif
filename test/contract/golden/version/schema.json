      "required": false,
      "default": false
    },
    "flags-for": {
      "type": "option",
      "description": "Show flags for a use case: filtering, output, pagination, auth, bulk",
      "required": false,
      "options": [
        "filtering",
        "output",
        "pagination",
        "auth",
        "bulk"
      ]
