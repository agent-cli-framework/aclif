{
  "command": "servicenow:discover",
  "category": "auth",
  "flags": {
    "profile": {
      "type": "option",
      "description": "Named profile from the config file",
      "required": false
    },
    "instance": {
      "type": "option",
      "description": "Named instance within the profile, for providers with more than one; embedding hosts pass it through",
      "required": false
    },
    "identity-token": {
      "type": "option",
      "description": "Identity token verified by the configured identity provider",
      "required": false
    },
    "instance-url": {
      "type": "option",
      "description": "ServiceNow instance URL (e.g., https://dev12345.service-now.com)",
      "required": false
    },
    "access-token": {
      "type": "option",
      "description": "ServiceNow OAuth2 access token",
      "required": false
    },
    "sn-username": {
      "type": "option",
      "description": "ServiceNow username",
      "required": false
    },
    "sn-password": {
      "type": "option",
      "description": "ServiceNow password",
      "required": false
    },
    "client-id": {
      "type": "option",
      "description": "OAuth2 client ID",
      "required": false
    },
    "client-secret": {
      "type": "option",
      "description": "OAuth2 client secret",
      "required": false
    }
  }
}
